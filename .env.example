###############################################################################
# TEE-Crafter — canonical .env.example
#
# Purpose: list every environment variable the TEE-Crafter CLI and its in-VM
# templates read, plus everything it forwards to Terraform (TF_VAR_*) and the
# common third-party keys they expect.
#
# Deliberately NOT listed here:
#   - Config for the sample apps under examples/.  Each example ships its own
#     `.env` (PORT, ENVIRONMENT, API_TOKEN, DATABASE_URL, SCORE_THRESHOLD,
#     MODEL_VERSION, …); those belong to the workload and reach it via
#     `--secrets-env`, not to the CLI.
#   - Variables read only by test fixtures.
#   - Standard POSIX / toolchain variables TEE-Crafter merely honours rather
#     than defines (TMPDIR, TF_LOG — the latter is noted in §27 for
#     convenience).
#   - `TEE_CRAFTER_BYOK_X_SECRET_ENV_BUNDLE_B64`, which deploy generates and
#     injects into the TEE; you never set it yourself.  It is described in §22.
#
# Location: keep this file (and your real `.env`) at the repository root —
# the directory you run `tee-crafter` from.  The CLI loads it via python-dotenv
# (searching the working directory upward) and bind-mounts that same directory
# into the Docker re-exec as /workspace, so `.env` and your `--source` paths
# resolve identically on the host and inside the container.
#
# Precedence (typical):
#   - Explicit CLI flags beat process environment.
#   - Click options with envvar= read from the environment when the flag is
#     omitted (see docs/cli_reference.md).
#   - tee-crafter loads .env from the working directory (upward) via python-dotenv.
#
# Terraform: any exported var TF_VAR_<name> sets input variable <name> in
# main.tf. List-type inputs are usually JSON strings when passed via env
# (e.g. '["10.0.0.0/8"]').
#
# Layout: §1-§5 are what you must set to deploy at all.  §6-§19 are optional
# host-side knobs, ordered build → bake → verify → teardown → tooling.  §20-§25
# are set by deploy inside the TEE and documented for reference only — you do
# not set them by hand.  §26-§27 are the Terraform layer underneath.
###############################################################################


###############################################################################
#                                                                             #
#   CREDENTIALS AND TARGETS — set these first                                 #
#                                                                             #
###############################################################################


###############################################################################
# 1. AWS (deploy + boto3)
###############################################################################

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

TF_VAR_aws_region=us-east-2
AWS_REGION=us-east-2
# AWS_DEFAULT_REGION=us-east-2

# --- Nitro host-proxy AWS credential posture (per-instance, not laptop) ---
# These live on the deployed instance, not in your laptop's .env, but
# are documented here for completeness.  Production defaults are strict.
#
# TEE_CRAFTER_PROXY_STRICT_IMDS=1   (production default; dev hatch)
#   Default 1 = refuse env-cred fallback when IMDSv2 is unreachable
#   (host_proxy sources AWS creds from the instance role only).
#   0 = re-enable laptop-style AWS_ACCESS_KEY_ID-from-env fallback
#   (ad-hoc smoke testing only).
# TEE_CRAFTER_PROXY_NO_CREDS=0   (default; operational knob)
#   1 = disable cred forwarding to the enclave entirely (test mode).


###############################################################################
# 2. Azure (SP auth — SGX / TDX / SNP-Azure / GPU-CC-Azure)
###############################################################################

# AZURE_SUBSCRIPTION_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_LOCATION=westus

# Default region hint for phases when TF_VAR_azure_location is unset
# TF_VAR_azure_location=westus


###############################################################################
# 3. GCP (SNP-GCP / TDX-GCP / GPU-CC-GCP)
###############################################################################

# GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
# GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=tee-crafter-deployer@PROJECT.iam.gserviceaccount.com
# CLOUDSDK_CONFIG=/workspace/.gcloud

# TF_VAR_gcp_project=
# TF_VAR_gcp_region=us-central1
# TF_VAR_gcp_zone=us-central1-a
# GOOGLE_PROJECT=              # fallback when TF_VAR_gcp_project unset (cloud_auth)
# GOOGLE_PROJECT_ID=           # read by gcloud / the Terraform provider, not by TEE-Crafter


###############################################################################
# 4. NVIDIA NRAS (gpu-cc-* deploy — host .env copied to VM for attestation)
###############################################################################

# NVIDIA_NRAS_API_KEY=

# (NVIDIA_NRAS_ROOT_CA was listed here as an override for the bundled NVIDIA
#  trust anchor.  Nothing in apps/cli/src reads it, so it does nothing -- the
#  anchor is baked into the client at render time from
#  certs/nvidia-nras-intermediate.pem.  Note that file is an INTERMEDIATE, not
#  a root, and is pinned by exact DER; it expires 2029-12-08.  See
#  docs/gpu_flow.md.)


###############################################################################
# 5. Pinned bake images (deploy, when --deploy is set)
#
# Resolution order (highest first):
#   1. --ami-id
#   2. TEE_CRAFTER_AMI_ID (legacy global)
#   3. Architecture-specific variable, where the platform has one (nitro-aws)
#   4. Per-platform variable (matches tee_platform)
#
# AWS: AMI id (ami-…). Azure/GCP: value your Terraform expects (gallery id,
# image name, etc.). Bake: tee-crafter internal bake-ami --tee-platform …
#
# Annotating a pinned image with what it is and when it was baked is fine:
#
#   AWS_SNP_AMI=ami-0dc3a149b36b33fff   # snp-aws-20260822, Milan x86_64
#
# The two load paths disagree about trailing comments, so this needs a helper.
# The CLI runs as `docker run --env-file .env`, and Docker's --env-file parser
# does NOT treat `#` as a comment once a value has started -- it takes the rest
# of the line verbatim -- whereas a shell that sources the same file strips it.
# One line therefore means two different things on the two paths, and the
# container receives the one with the comment glued on, which surfaces as
# `InvalidAMIID.Malformed: Invalid id: "ami-0dc3a149b36b33fff   # snp-aws-..."`.
# The image variables are read through a helper that drops a trailing comment
# (safe: AMI ids, Azure resource IDs and GCP image URIs cannot contain `#`).
# Other variables are NOT treated this way -- keep comments on their own line
# everywhere else.
#
# nitro-aws needs TWO AMIs, because it runs on both architectures and an AMI
# serves exactly one. There is no combined AWS_NITRO_AMI: "the Nitro AMI" is
# not a well-defined thing, since an arm64 instance cannot boot an x86_64
# image. Set the one(s) you use; the CLI picks by the architecture of the
# instance type being deployed, so you never pass --ami-id:
#
#   x86_64   (c6a.*)                 UEFI Secure Boot CAN be enrolled
#   arm64    (c/m/r 6g-9g Graviton)  Secure Boot cannot — AL2023's
#                                    amazon-linux-sb-keys package ships
#                                    pre-signed PK/KEK/db for x86_64 only, so
#                                    an arm64 AMI is always tagged
#                                    tee-crafter-secure-boot=disabled and
#                                    deploying it needs
#                                    TEE_CRAFTER_ALLOW_NO_SECURE_BOOT=1
#
# Bake them separately:
#   tee-crafter internal bake-ami --tee-platform nitro-aws \
#     --instance-type c6a.xlarge                            # x86_64, SB on
#   tee-crafter internal bake-ami --tee-platform nitro-aws \
#     --instance-type c7g.xlarge --no-enable-secure-boot    # arm64
#
# snp-aws has no arm64 variant: AMD SEV-SNP is an AMD CPU feature, so one pin
# covers the platform.
###############################################################################

# TEE_CRAFTER_AMI_ID=
# AWS_NITRO_AMI_X86_64=       # nitro-aws on c6a.* (Secure Boot enrollable)
# AWS_NITRO_AMI_ARM64=        # nitro-aws on Graviton (Secure Boot not available)
# AWS_SNP_AMI=                # snp-aws
# AWS_GPU_CC_AMI=             # gpu-cc-aws
# AZURE_SGX_IMAGE=            # sgx-azure
# AZURE_TDX_IMAGE=            # tdx-azure
# AZURE_SNP_IMAGE=            # snp-azure
# AZURE_GPU_CC_IMAGE=         # gpu-cc-azure
# GCP_TDX_IMAGE=              # tdx-gcp
# GCP_SNP_IMAGE=              # snp-gcp
# GCP_GPU_CC_IMAGE=           # gpu-cc-gcp


###############################################################################
#                                                                             #
#   DEPLOY, BUILD AND BAKE — optional host-side knobs                         #
#                                                                             #
###############################################################################


###############################################################################
# 6. Default deploy Click envvars (used when the flag is omitted)
###############################################################################

# TEE_CRAFTER_INSTANCE_TYPE=
#   Default --instance-type when the flag is omitted. The instance type fully
#   determines vCPU / RAM / GPU (CVM/GPU) or the host EC2 type (Nitro). When
#   blank, deploy uses the platform's catalog default. Discover the options
#   with `tee-crafter list-instances [--tee-platform <p>]`. No compute presets.
# TEE_CRAFTER_SPOT=0
#   Set 1 to request a spot / low-priority / preemptible instance (= --spot).

# TEE_CRAFTER_BATCH=1
#   = --batch. Exactly one of --batch / --persistent is required; there is no
#   default, so setting neither makes deploy abort.
# TEE_CRAFTER_PERSISTENT=1
#   = --persistent. Mutually exclusive with TEE_CRAFTER_BATCH. Unavailable on
#   sgx-azure (batch-only).
# TEE_CRAFTER_BATCH_TIMEOUT=3600
#   Hard timeout in seconds for the batch job.
# TEE_CRAFTER_INPUT_DIR=./inputs
#   = --input-dir. Uploaded as a plain tar.gz and extracted IN THE CLEAR on the
#   host, then bind-mounted read-only at /input. NOT encrypted to the TEE — use
#   `tee-crafter seal-input` for sensitive data. See docs/cli_reference.md.

# TEE_CRAFTER_SECRETS_ENV=/abs/path/app.env
#   = --secrets-env. Dotenv delivered to the workload at
#   /run/tee_crafter/app.env. Envelope-sealed with --byok aws-kms/gcp-kms;
#   baked into the measured image without BYOK. Sealing does NOT work with
#   azure-kv (that adapter returns no plaintext DEK).
# TEE_CRAFTER_CONTAINER_PORT=8080
#   = --container-port. Port your app listens on. Auto-detected from EXPOSE
#   when unset, falling back to 8080.

# TEE_CRAFTER_EGRESS_MODE=deny
#   = --egress-mode. deny (default) | vpc | nat.
# TEE_CRAFTER_EGRESS_ALLOW=db.example.com:5432
#   = --egress-allow. 'host:port' or 'cidr:port'. Requires egress mode vpc/nat.
#   The flag is repeatable; via env, supply one value.

# TEE_CRAFTER_ALLOW_SETUP_EGRESS_NAT=0   (SECURITY GATE; production default)
#   1 = permit the one-time setup egress to leave via a NAT gateway rather than
#   VPC endpoints.  Widens the instance's reachable network during bake/deploy,
#   and a NAT gateway bills hourly until torn down.
# TEE_CRAFTER_RESIDENCY_POLICY=
#   Optional data-residency constraint checked before any region is used, e.g.
#   "eu-only".  Empty = no residency constraint enforced.

# TEE_CRAFTER_SERVICE_PROFILE=default
#   default | long-lived | short-lived | streaming
# (When non-default, deploy sets TEE_CRAFTER_SERVICE_MODE=1 and service env.)

# TEE_CRAFTER_SIEM=none
# TEE_CRAFTER_SIEM_CONFIG=/abs/path/siem.json

# TEE_CRAFTER_BYOK=none
# TEE_CRAFTER_BYOK_CONFIG=/abs/path/byok.json


###############################################################################
# 7. Container vulnerability gate (deploy — flow_container.py)
#
# The gate blocks on CRITICAL/HIGH findings that have an UPSTREAM FIXED VERSION.
# Findings the distro marks affected / fix_deferred / will_not_fix are counted,
# printed and recorded in the provenance, but do not block -- nothing an
# operator can do clears them, and a gate that cannot be satisfied only teaches
# people to pass --allow-vulnerable.  See docs/container_build.md.
###############################################################################

# TEE_CRAFTER_ALLOW_VULNERABLE=0   (production default; dev hatch)
#   Set 1 to continue after ANY finding, fixable or not.  Recorded in
#   provenance with gate_allowed=true.  NEVER set in production -- prefer a
#   checked-in <source>/.trivyignore listing the specific CVE IDs you have
#   reviewed, which leaves every other finding blocking and is recorded as
#   accepted_findings.  (Trivy honours .trivyignore; the Grype fallback does
#   not, and leaves everything blocking rather than ignoring the file.)

# TEE_CRAFTER_VULN_STRICT=0
#   Set 1 to restore zero-tolerance: every CRITICAL/HIGH blocks, fix or no fix.
#   Ledger checks VLN-002/003/004 follow the same setting, so the deploy gate
#   and `verify-provenance` never disagree.

# TEE_CRAFTER_VULN_HIGH_THRESHOLD=0
#   Max FIXABLE HIGH tolerated by ledger check VLN-003.

# TEE_CRAFTER_VULN_MEDIUM_THRESHOLD=25
#   Max FIXABLE MEDIUM tolerated by ledger check VLN-004.


###############################################################################
# 8. Advanced compute overrides (optional; recorded as DH-* provenance rows)
###############################################################################

# TEE_CRAFTER_COMPUTE_OVERRIDE_CPU=         (Nitro enclave / raw cpu)
# TEE_CRAFTER_COMPUTE_OVERRIDE_RAM_MB=
# TEE_CRAFTER_COMPUTE_OVERRIDE_INSTANCE_TYPE=
#   Same as --instance-type. SNP accepts ANY size in the cloud-supported family
#   (m6a/c6a/r6a + m7a/c7a/r7a on AWS, DCas/ECas v5+v6 on Azure, n2d-* on GCP),
#   as long as its (CPU generation, vCPU tier) was captured at bake (see
#   TEE_CRAFTER_SNP_CAPTURE_VCPUS in §10).
# TEE_CRAFTER_COMPUTE_OVERRIDE_GPU_MODEL=
# TEE_CRAFTER_COMPUTE_OVERRIDE_GPU_COUNT=
# TEE_CRAFTER_COMPUTE_OVERRIDE_SPOT=0


###############################################################################
# 9. Batch systemd unit sizing (flow_batch_entrypoint — optional)
###############################################################################

# TEE_CRAFTER_BATCH_CPU=2
# TEE_CRAFTER_BATCH_RAM_MB=4096


###############################################################################
# 10. Image bake — measurement capture, retries, staging, supply-chain pins
#
# Everything `tee-crafter internal bake-ami` reads.  The images it produces are
# pinned in §5.
###############################################################################

# --- Measurement capture and the pin registry ---
# TEE_CRAFTER_SNP_CAPTURE_VCPUS=2,4,8,16,32,48,64,96
#   Comma-separated vCPU tiers that `bake-ami` walks (ascending) per CPU
#   generation (Milan + Genoa) when capturing AMD SEV-SNP launch measurements.
#   The bake early-stops a generation after its two smallest tiers if their
#   digests match (vCPU-independent → one digest covers that generation). Widen
#   to pre-pin very large shapes (subject to vCPU quota); narrow to speed up
#   bakes. Default shown.

# TEE_CRAFTER_MEASUREMENTS_DIR=
#   Override the launch-measurement registry root (where `bake-ami` writes
#   auto-pins and `deploy` reads them). The Docker wrapper sets this
#   automatically so pins persist to your repo's
#   apps/cli/src/tee_crafter/measurements across container re-execs — only set
#   it by hand for a custom/shared registry.
#
#   No literal default is shown because there is no fixed one: when unset the
#   root is computed from the installed package location, which is
#   `<site-packages>/tee_crafter/measurements` on the host and
#   `/opt/tee-crafter/src/tee_crafter/measurements` inside the CLI container.
#   Whitespace-only counts as unset, so a blank export falls back to the
#   packaged directory instead of writing pins relative to the working
#   directory (core/measurements/registry.py::_resolve_registry_dir).

# TEE_CRAFTER_REQUIRE_ATTESTATION_TOOLS=1   (production default; dev hatch)
#   The bake refuses to write its completion marker unless every attestation
#   binary it is supposed to install is present and executable (snpguest on the
#   SNP platforms, nitro-tpm-attest on the NitroTPM ones).  0 = let the bake
#   finish anyway, which produces an image that cannot attest at runtime.
# TEE_CRAFTER_BAKE_SUFFIX=
#   Extra suffix appended to the baked image name, for keeping parallel bakes of
#   one platform apart.  Empty = the generated name stands alone.

# --- Retries, auto-approve, capacity wait ---
# TEE_CRAFTER_PHASE4_MAX_RETRIES=2
# TEE_CRAFTER_TF_AUTO_APPROVE=0
# TEE_CRAFTER_AWS_GPU_CAPACITY_WAIT_SECONDS=600

# Internal dev only — allow public base AMI without prior bake (deploy / from_build)
# TEE_CRAFTER_ALLOW_UNBAKED_BASE_AMI=0   (production default; dev hatch)
#   1 = launch on a stock public AMI instead of a `bake-ami`-baked one.
#   Maintainer-only path; production always uses the baked AMI tagged
#   tee-crafter-secure-boot=enabled.

# terraform_step.py echoes this if set (only useful when your Terraform declares it)
# TF_VAR_key_name=my-debug-keypair

# --- Azure VHD staging storage accounts (auto-named if unset) ---
# Override only to reuse an existing account / satisfy naming policy.
# TEE_CRAFTER_SNP_STORAGE_ACCOUNT=
# TEE_CRAFTER_TDX_STORAGE_ACCOUNT=
# TEE_CRAFTER_GPU_CC_STORAGE_ACCOUNT=
# TEE_CRAFTER_SGX_STORAGE_ACCOUNT=

# --- Nitro enclave image builder base (core/enclave/enclave.py) ---
# TEE_CRAFTER_NITRO_BUILDER_BASE=amazonlinux@sha256:...

# --- Bake-time supply-chain pins (setup_*.sh — optional) ---
# TEE_CRAFTER_RUSTUP_SHA256=
# TEE_CRAFTER_AZ_CLI_INSTALLER_SHA256=
# TEE_CRAFTER_ARK_MILAN_SHA256=
# TEE_CRAFTER_ARK_GENOA_SHA256=


###############################################################################
# 11. Provenance signing (build — core/audit/signing.py)
###############################################################################

# TEE_CRAFTER_PROVENANCE_SIGNING_KEY="-----BEGIN PRIVATE KEY-----..."
# TEE_CRAFTER_PROVENANCE_SIGNING_KEY_FILE=/path/to/ed25519.pem
# TEE_CRAFTER_PROVENANCE_ALLOW_EPHEMERAL=0   (production default; dev hatch)
#   1 = per-build ephemeral signing key.  NEVER set in production —
#   verifiers cannot pin a single public key across builds.


###############################################################################
#                                                                             #
#   ATTESTATION TRUST ROOTS AND PER-PLATFORM HARDENING (§12-§17)              #
#                                                                             #
#   What the verifier client will and will not accept.  Every dev hatch in     #
#   this block weakens a check that stands between you and an unattested host. #
#                                                                             #
###############################################################################


###############################################################################
# 12. SNP client hardening (templates/snp/{aws,azure,gcp}/client.template.py)
###############################################################################

# TEE_CRAFTER_STRICT_SNP_AK_BINDING=1   (production default; dev hatch)
#   1 = fail closed (production).  0 permits legacy vTPM/HCL paths where
#   REPORT_DATA cannot carry sha256(ak_pub).  Never set to 0 in prod.
#   Only a recognised falsy spelling (0, false, no, n, off) disables it; any
#   other value, recognised or not, leaves the gate on.  Read by the Azure CVM
#   clients only (snp-azure, gpu-cc-azure) -- snp-aws and snp-gcp read a real
#   SEV-SNP report, so the weaker vTPM/HCL binding cannot arise there.

# TEE_CRAFTER_SNP_REQUIRE_SMT_DISABLED=0   (SECURITY GATE; default warn-only)
#   All three SNP clients read the guest POLICY bit 16 out of the attestation
#   report.  When it is set, the guest may share a physical core with sibling
#   hyperthreads, which exposes it to cross-thread side-channel classes.
#   0 (default) = print a WARNING and continue.
#   1 = treat it as fatal and refuse the connection.
#   Left at 0 by default because the major clouds do not universally expose an
#   SMT-off SNP shape; set it to 1 where your instance family does, and the
#   side-channel classes are in your threat model.  Read by all three SNP
#   client templates (templates/snp/{aws,azure,gcp}/client.template.py); line
#   numbers are deliberately omitted because they go stale.
#   Any recognised truthy spelling enables the fatal check -- 1, true, yes, y
#   or on.  It used to be an exact match against "1", so writing `true` to
#   harden a deployment silently left it warn-only.


###############################################################################
# 13. TDX-Azure attestation — evidence format and MAA
#     (core/builder/platforms.tdx_evidence_format, templates/tdx/azure/*,
#      templates/common/tee_crafter_maa.py)
###############################################################################
#
# Read this before deploying tdx-azure: the default does not work on Azure, and
# that is deliberate rather than an oversight.
#
# An Azure confidential VM runs under a Microsoft paravisor, and the guest there
# cannot obtain an Intel DCAP quote at all. vTPM NV index 0x01400001 holds an
# Azure-format attestation report -- 32-byte HCLA header, then the *hardware
# report* at offset 32 (1024 bytes for Intel TDX, 1184 for AMD SEV-SNP), then
# runtime data at 1216. For TDX that hardware report is a raw TDREPORT whose
# REPORTMACSTRUCT is MAC'd with a key only the TDX module and the Quoting
# Enclave hold. Nobody else can verify it, and MAA's /attest/TdxVm endpoint --
# which verifies *quotes* -- rejects it.
#   https://learn.microsoft.com/en-us/azure/confidential-computing/guest-attestation-confidential-virtual-machines-design

# TEE_CRAFTER_TDX_EVIDENCE_FORMAT=dcap
#   dcap         The TD quotes itself (configfs-tsm or /dev/tdx-guest), the
#                client verifies the ECDSA signature and the PCK chain against
#                Intel's root CA, and the session is bound into the
#                hardware-signed report_data. Strictly the stronger option, and
#                the correct one for tdx-gcp and bare metal.
#   azure-guest  The TD exchanges its vTPM evidence for an MAA
#                /attest/AzureGuest token using Microsoft's guest-attestation
#                library, and the client verifies that token. REQUIRED on Azure.
#
#   Two things change when you select azure-guest, and both are downgrades worth
#   naming rather than burying:
#     - The trust root becomes Microsoft Azure Attestation instead of Intel.
#     - The session binding moves from hardware-signed report_data to the
#       MAA-signed client-payload nonce, because report_data on a paravisor CVM
#       belongs to the paravisor. It is still a real binding -- the client
#       refuses a token whose nonce is not this session's -- but MAA's signature
#       is what stands behind it, not the TDX module's.
#   The default stays dcap so that moving to a weaker trust root is always
#   something an operator asked for. A typo is a hard error, never a silent
#   revert to dcap: on Azure that revert produces a VM that cannot attest.
#
#   Renamed: this was 'hcla'. That name described the blob, and the code behind
#   it POSTed the raw Azure envelope to /attest/TdxVm -- a combination that
#   could not succeed. 'hcla' is now rejected by name with an explanation.

# TEE_CRAFTER_MAA_ENDPOINT=
#   The MAA instance that adjudicates AzureGuest evidence, and the same
#   authority the Secure Key Release below attests to. Required whenever
#   TEE_CRAFTER_TDX_EVIDENCE_FORMAT=azure-guest or TEE_CRAFTER_BYOK=azure-skr;
#   no default, because an attestation service picked up from whatever happens
#   to be in the environment is not an attestation service. Both the in-TEE app
#   and the verifier client read it, and they must agree -- the client pins the
#   token's `iss` to this value and refuses a token issued by anyone else.
#   Regional shared providers work (https://sharedwus.wus.attest.azure.net);
#   use your own provider when you need a custom attestation policy.

# TEE_CRAFTER_ATTESTATION_CLIENT=/usr/local/bin/AttestationClient
#   Microsoft's guest-attestation binary (azguestattestation1 +
#   cvm-attestation-sample-app), baked into all three Azure CVM images by
#   scripts/common/azure_guest_attestation.sh. Override only if your image stages
#   it elsewhere. On tdx-azure its absence is fatal: a paravisor TD has no other
#   route to verifiable evidence, so the app refuses to serve rather than falling
#   back to something unverifiable. snp-azure and gpu-cc-azure do not use it --
#   they read a real SEV-SNP report -- but they do use its sibling below.

# TEE_CRAFTER_AZURE_SKR_TOOL=/usr/local/bin/AzureAttestSKR
#   Microsoft's Secure Key Release tool, from the same package and the same bake
#   fragment. Needed by TEE_CRAFTER_BYOK=azure-skr on all three Azure CVM
#   platforms: Key Vault wraps a released key to TpmEphemeralEncryptionKey, whose
#   private half is sealed to the vTPM, so this process does the release AND the
#   unwrap and hands back only the DEK. Nothing here couples it to
#   TEE_CRAFTER_TDX_EVIDENCE_FORMAT -- the tool fetches its own
#   /attest/AzureGuest token from TEE_CRAFTER_MAA_ENDPOINT regardless of what
#   format our RA-TLS evidence uses.


###############################################################################
# 14. Intel TCB collateral (builder fetches, verifier client re-checks offline)
###############################################################################
# Applies to every platform with an Intel DCAP quote: sgx-azure, tdx-azure,
# tdx-gcp and gpu-cc-gcp (its CPU side is TDX).
#
# The build fetches TCBInfo, QEIdentity and the PCK CRLs from Intel PCS,
# verifies each document's signature against the pinned Intel SGX Root CA, and
# writes tcb_collateral.json beside the generated client.  The client re-verifies
# it offline, so the verify path needs no network.
#
# Retired: TEE_CRAFTER_TDX_QE_IDENTITY_URL and
# TEE_CRAFTER_TDX_ALLOW_MISSING_QE_IDENTITY.  The first named a single endpoint
# and cannot express the six now fetched; the second guarded a hand-copied QE-SVN
# floor that was deleted in favour of real signed collateral.  Setting the URL
# one without TEE_CRAFTER_PCS_BASE_URL now fails the build loudly rather than
# silently reaching the public PCS and defeating the air-gap it existed for.

# TEE_CRAFTER_FMSPC=
#   The platform's FMSPC (12 hex chars).  A build host cannot discover this --
#   it identifies the CPU model and only exists in a real quote's PCK leaf -- and
#   Intel's /tcb endpoint requires it.  Without it the bundle ships QEIdentity
#   and CRLs but no TCBInfo, and the client refuses the quote while printing the
#   FMSPC it just parsed, so recovery is one rebuild.  Set it once per CPU
#   generation.
# TEE_CRAFTER_PCS_BASE_URL=https://api.trustedservices.intel.com
#   Point at an internal PCS mirror for air-gapped builds.
# TEE_CRAFTER_PCS_CERTIFICATES_BASE_URL=https://certificates.trustedservices.intel.com
#   Second host: the Intel SGX Root CA CRL is served from here, not from the API
#   host.  The two overrides are INDEPENDENT on purpose -- mirroring the API does
#   not imply mirroring the certificate host.  Sharp edge: if you set only the
#   API override, the build still reaches the public certificate host.  Air-gapped
#   deployments must set both.
# TEE_CRAFTER_TCB_COLLATERAL=
#   Path to a pre-staged tcb_collateral.json, overriding the one beside the
#   client.  For air-gapped verification.
# TEE_CRAFTER_TCB_COLLATERAL_MAX_AGE_HOURS=168   (production default: 7 days)
#   Staleness bound on the bundle's fetched_at.  Intel's signature says what a
#   document contains, not when you fetched it, so age is enforced separately.
#   Intel's own nextUpdate is ALWAYS enforced and this does not relax it.
#   0 or negative is an error, not a way to disable the check.
# TEE_CRAFTER_TCB_ALLOW_STATUS=              (DH-018; default: UpToDate only)
#   Comma-separated additions to the accepted tcbStatus set.  Only
#   SWHardeningNeeded, ConfigurationNeeded and
#   ConfigurationAndSWHardeningNeeded may be named.  OutOfDate and Revoked are
#   refused under every policy, and naming one here fails the run rather than
#   silently narrowing the policy.
# TEE_CRAFTER_ALLOW_UNVERIFIED_TCB_STATUS=   (DH-009; production must leave unset)
#   1 = skip TCB status evaluation entirely.  Accepts an out-of-date or revoked
#   platform TCB.  Prints a full-width banner; never prints PASSED.
# TEE_CRAFTER_TCB_EVAL_MODULE=
#   Path to tee_crafter_tcb_eval.py when it is not beside the client.  The build
#   stages it automatically; this is an escape hatch for unusual layouts.


###############################################################################
# 15. SGX client floors (templates/sgx/client.template.py)
###############################################################################

# No ISV-SVN or TCB-evaluation-date floor is configurable.  The Gramine manifest
# sets no sgx.isvsvn, so Gramine signs enclaves at 0, and any floor above 0
# would reject TEE-Crafter's own enclaves.  See docs/sgx_flow.md.
#
# The SGX-relevant gate that does exist is
# TEE_CRAFTER_ALLOW_UNPINNED_MEASUREMENT -- see §22.

# TEE_CRAFTER_ALLOW_NON_ENCLAVE_SGX=0   (SECURITY GATE; production default)
#   1 = accept a workload running *outside* an SGX enclave, i.e. with no
#   hardware isolation and no MRENCLAVE to attest.  Off by default and only a
#   recognised truthy spelling opens it.  Diagnostics only.
# TEE_CRAFTER_SGX_ENCLAVE_SIZE=
#   Enclave heap size passed to the Gramine manifest (e.g. 4G).  Unset lets the
#   platform default apply.


###############################################################################
# 16. GPU confidential compute — deploy gates (gpu_cc/aws_phase.py, runtime)
###############################################################################

# TEE_CRAFTER_ACCEPT_PARTIAL_CC=0   (production default; dev hatch)
#   1 = allow deploy when GPU CC evidence is partial.  Recorded in
#   the audit chain.  Production must use gpu-cc-gcp (full CPU+GPU CC).

# TEE_CRAFTER_ALLOW_UNVERIFIED_AWS_CPU_ATTESTATION=0   (SECURITY GATE)
#   gpu-cc-aws only.  That platform has NO CPU TEE: the NitroTPM extension
#   carries self-asserted PCR JSON with no TPM2 quote, no attestation key and
#   no signature, and there is no AWS NitroTPM root certificate to chain an
#   attestation key to.  Nothing about the host CPU, its boot chain or its
#   memory can be proven.  The client therefore FAILS CLOSED by default -- it
#   exits 1 rather than perform a check that resembles attestation without
#   being one.
#   1 = proceed on NVIDIA GPU attestation alone, with the CPU host explicitly
#   unattested.  The client prints a banner, labels any PCRs it shows
#   "SELF-REPORTED, UNVERIFIED", never pins a measurement from them, and
#   reports security_model=gpu-only-cpu-unattested.  See docs/gpu_flow.md.

# TEE_CRAFTER_GPU_CC_MODE=PROTECT
#   Passed to initialize_gpu_cc_mode() inside the CVM (nvidia_attestation.py).

# TEE_CRAFTER_EXPECTED_VTPM_PCRS=
#   Runtime pin "idx:hex,..." (gpu_cc/gcp client template).

# TEE_CRAFTER_STRICT_TSM=1   (production default; flip to 0 = dev hatch)
#   Default strict: configfs-tsm failure refuses silent fallback to
#   /dev/tdx-guest ioctl (tdx/gcp + gpu_cc/gcp).  0 = legacy
#   best-effort fallback (ad-hoc work on stale kernels only).

# TEE_CRAFTER_ALLOW_UNBOUND_AUDIT_CHAIN=0   (SECURITY GATE; production default)
#   gpu-cc-aws.  1 = accept a runtime audit-log stream whose HMAC chain
#   commitment is not bound into attested evidence, so the log can be replaced
#   without detection.  Off by default.
# TEE_CRAFTER_EXPECTED_NITROTPM_PCRS=
#   Reference NitroTPM PCR set "idx:hex,..." for gpu-cc-aws.  Deploy fills this
#   from the values bake-ami captured; set by hand only to add a baseline.
# TEE_CRAFTER_NITRO_TPM_ATTEST_BIN=/usr/bin/nitro-tpm-attest
#   Path to the NitroTPM attestation helper the bake installs.  Override only
#   if your image stages it elsewhere.


###############################################################################
# 17. NRAS egress policy helpers (gpu-cc-* — nras_egress.py → Terraform)
###############################################################################

# TEE_CRAFTER_NRAS_CIDRS=203.0.113.0/24,198.51.100.0/24
#   Production: pin NVIDIA's published NRAS edge CIDRs here.
# TEE_CRAFTER_NRAS_STRICT=1   (production default; flip to 0 = dev hatch)
#   Default strict: no CIDRs => no NRAS firewall rule => attestation
#   fails until CIDRs are supplied (fail-closed).  0 = legacy
#   broad-internet HTTPS/443 fallback (ad-hoc prototyping only).

# TEE_CRAFTER_NRAS_HOSTS=nras.attestation.nvidia.com
#   Hostnames to resolve into egress CIDRs when TEE_CRAFTER_NRAS_CIDRS is not
#   given explicitly.
# TEE_CRAFTER_NRAS_RESOLVE=1
#   1 (default) = resolve TEE_CRAFTER_NRAS_HOSTS at deploy time.  0 = do not
#   resolve, which leaves the allowlist empty and therefore fails closed under
#   TEE_CRAFTER_NRAS_STRICT=1.

# Or set Terraform var directly (JSON list string):
# TF_VAR_nras_egress_cidrs=["203.0.113.0/24"]
# TF_VAR_allow_nras_broad_internet=false   (production default)
# TF_VAR_allow_nras_egress=true


###############################################################################
#                                                                             #
#   LIFECYCLE AND HOST TOOLING                                                #
#                                                                             #
###############################################################################


###############################################################################
# 18. Teardown, redeploy integrity and failure handling
#     (core/iac/platforms.py, local_docker_prune, deploy/from_build.py)
###############################################################################

# TEE_CRAFTER_SKIP_POST_DESTROY_SHRED=0   (production default; dev hatch)
#   1 = keep tfstate backup / keys after successful terraform destroy
#   (forensic mode only).

# TEE_CRAFTER_SKIP_LOCAL_DOCKER_PRUNE=0   (production default; dev hatch)
#   1 = skip pruning pipeline Docker image after destroy.

# TEE_CRAFTER_DESTROY_TIMEOUT=2700   (seconds; default 45 minutes)
#   Wall-clock budget for `terraform destroy`.  Raise it for slow tenants.
#   This is not cosmetic: the post-destroy shred only runs when destroy
#   reports success, so a teardown that is merely *slow* is recorded as failed
#   and leaves SSH private keys, `siem.env` and `byok.env` behind in the build
#   directory.  Values that are non-numeric or <= 0 are ignored and the default
#   applies (core/iac/platforms.py::_destroy_timeout_seconds).

# TEE_CRAFTER_SKIP_BUILD_INTEGRITY_CHECK=0   (SECURITY GATE; = --skip-integrity-check)
#   `deploy-from-build` re-deploys a build directory that already exists on
#   disk.  By default it verifies that directory's provenance hash chain and
#   Ed25519 signature first, which is what stops a tampered build dir from
#   being pushed into a TEE.
#   1 = redeploy even when verification fails.  NOT for production: the build
#   dir is read straight off local disk and its artifacts are what get
#   measured into the enclave.

# TEE_CRAFTER_FORCE_UNLOCK=0
#   1 = break a stale Terraform state lock left by a killed run.  Only safe
#   when you are certain no other apply is in flight; two concurrent applies
#   against one state file can orphan billing resources.

# TEE_CRAFTER_KEEP_ON_FAILURE=0   (= --keep-on-failure)
#   1 = leave provisioned infrastructure running when a deploy fails, for
#   debugging.  Default tears it down; otherwise a failed run leaves the
#   instance (and any NAT gateway) billing until someone runs
#   `tee-crafter destroy`.


###############################################################################
# 19. Host CLI mechanics — Docker re-exec, SSH transport, debug logging
#     (cli/main.py, core/remote/{ssm,gcp_ssh,azure_ssh}.py)
###############################################################################

# --- Docker re-exec ---
# TEE_CRAFTER_DOCKER_IMAGE=tee-crafter
#   Image used for the host-side Docker re-exec (default "tee-crafter").
# TEE_CRAFTER_IN_DOCKER=1
#   Set by tooling when already inside the container (disables re-exec).
# TEE_CRAFTER_EXTRA_DOCKER_MOUNTS=/host/path:/container/path
#   Comma-separated extra docker -v entries for the CLI container re-exec
#   (e.g. mounting an external credentials or cache directory).

# --- SSH/SCP transport reliability (core/remote/{gcp_ssh,azure_ssh}.py) ---
# Bounded retries guard against transient SSH transport-layer errors (sshd
# MaxStartups gate, IAP/Bastion local listener resets, brief banner-exchange
# failures) that surface as
# "kex_exchange_identification: read: Connection reset by peer" or similar.
# Only transient transport errors are retried — genuine remote-command failures
# are returned on the first attempt.
#
# TEE_CRAFTER_SSH_RETRIES: max attempts per SSH/SCP invocation (default 4, clamped 1..10)
# TEE_CRAFTER_SSH_RETRY_BACKOFF: base seconds for exponential backoff
#                               (sleep = base * 2**(attempt-1), capped at 30s; default 2.0)
# TEE_CRAFTER_SSH_RETRIES=4
# TEE_CRAFTER_SSH_RETRY_BACKOFF=2.0

# --- SSH connection multiplexing (ControlMaster) ---
# Speeds up deploys that issue 20-40 small SSH/SCP calls over a Bastion / IAP
# tunnel by reusing the initial KEX'd connection across calls.  See
# docs/optimizations.md §3.
# TEE_CRAFTER_SSH_MUX: set to 0 to disable connection multiplexing
#                     (debugging only; default 1).
# TEE_CRAFTER_SSH_MUX_PERSIST: how long the multiplexed master stays alive
#                              after the last client disconnects.  Accepts
#                              any ssh ControlPersist value (e.g. "30s",
#                              "5m", "10m"; default 5m).
# TEE_CRAFTER_SSH_MUX=1
# TEE_CRAFTER_SSH_MUX_PERSIST=5m

# --- Local image freshness (two DIFFERENT checks) ---
# The names differ only in word order and they do different things.  Setting
# one does not affect the other.
#
# TEE_CRAFTER_SKIP_IMAGE_STALENESS_CHECK=0
#   Host side, before the Docker re-exec.  The CLI compares the checkout's
#   source fingerprint against the one recorded in the local image and REBUILDS
#   on a mismatch, because the sources live in the image rather than being
#   bind-mounted -- without it, editing the CLI and re-running silently ran the
#   previous build.  1 = skip the rebuild and run the image as-is.
# TEE_CRAFTER_SKIP_STALE_IMAGE_CHECK=0
#   Inside the container.  Only prints a WARNING when the image's baked source
#   tree differs from whatever is mounted at /workspace.  1 = suppress the
#   warning.  Blocks nothing either way.

# --- Debug logging (remote SSM / SSH helpers + platform phases) ---
# Any of these may enable DEBUG logging in core/remote/{ssm,gcp_ssh,azure_ssh}.py
# TEE_CRAFTER_DEBUG=0
# TEE_CRAFTER_DEBUG_NITRO=0
# TEE_CRAFTER_DEBUG_SGX=0
# TEE_CRAFTER_DEBUG_SNP_AWS=0
# TEE_CRAFTER_DEBUG_TDX=0
# TEE_CRAFTER_DEBUG_GCP=0


###############################################################################
#                                                                             #
#   SET BY DEPLOY INSIDE THE TEE (§20-§25) — reference only                   #
#                                                                             #
#   deploy writes these into the systemd unit environment / staged .env files  #
#   on the instance.  Leave them unset on the host; they are documented here    #
#   so you can read a running VM's configuration and know what it means.       #
#                                                                             #
###############################################################################


###############################################################################
# 20. Persistent RA-TLS service — in-TEE env (service/policy.py + deploy)
#
# Written to service_policy.env by deploy; values below are what systemd
# templates / ServicePolicy.to_env() use. Prefer --service-profile on CLI.
###############################################################################

# TEE_CRAFTER_SERVICE_MODE=0
# TEE_CRAFTER_CERT_TTL_SEC=3600
# TEE_CRAFTER_CERT_GRACE_SEC=300
# TEE_CRAFTER_REATTEST_INTERVAL_SEC=600
# TEE_CRAFTER_REATTEST_GRACE_SEC=60
# TEE_CRAFTER_MAX_CONNS=1024
# TEE_CRAFTER_ON_ATTEST_FAIL=drain
#   drain | hard_stop | warn
# TEE_CRAFTER_KEEPALIVE=1
# TEE_CRAFTER_STREAMING=0


###############################################################################
# 21. SIEM — in-TEE env (siem_mode.SiemConfig.to_env + runtime bootstrap)
#
# Host: use TEE_CRAFTER_SIEM + TEE_CRAFTER_SIEM_CONFIG paths (§6); JSON may
# include egress_mode, egress_allowlist_cidrs, egress_ports → siem_egress_terraform
# sets TF_VAR_* (see §26).
###############################################################################

# TEE_CRAFTER_SIEM_ENABLED=0
#   1 = engage the SIEM exporter + the in-TEE fail-closed gate.  Set by
#   `tee-crafter siem-stage` / --siem; 0 disables both.
# TEE_CRAFTER_SIEM=none
#   none | syslog-cef | splunk-hec | datadog
# TEE_CRAFTER_SIEM_INTERVAL_SECONDS=60
#   Exporter cadence (seconds).  Also the base for the fail-closed lag
#   budget (default budget = 3 x interval) when MAX_LAG is unset.
# TEE_CRAFTER_SIEM_SIGN_EVENTS=1
#   1 = Ed25519-sign each exported event (tamper-evident chain).  0 = off.
# TEE_CRAFTER_SIEM_FAIL_OPEN=0   (production default; dev hatch)
#   0 = workload refuses requests if the SIEM exporter is dark
#   (fail closed).  1 = legacy log-and-keep-serving (prototyping).
# TEE_CRAFTER_SIEM_MAX_LAG_SECONDS=
#   Explicit fail-closed lag budget (seconds).  Empty = derive from
#   INTERVAL_SECONDS (3 x interval).  Lower = stricter liveness.
# TEE_CRAFTER_SIEM_GRACE_SECONDS=60
#   Startup grace after process boot before the fail-closed gate can trip
#   (lets the first export land).  Raise on slow-export backends.

# --- syslog-cef ---
# TEE_CRAFTER_SIEM_HOST=siem.internal
# TEE_CRAFTER_SIEM_PORT=514
# TEE_CRAFTER_SIEM_PROTOCOL=udp
#   tcp | udp (default tcp in the exporter; udp shown for the common relay).
# TEE_CRAFTER_SIEM_FACILITY=13
#   Syslog facility code 0-23 (default 13 = log audit).
# TEE_CRAFTER_SIEM_SEVERITY=5
#   Syslog severity code 0-7 (default 5 = notice).
# TEE_CRAFTER_SIEM_HOSTNAME=
#   Override the CEF hostname field (default = the instance hostname).
# TEE_CRAFTER_SIEM_CONNECT_TIMEOUT=10
#   TCP connect timeout (seconds) to the syslog collector.
# TEE_CRAFTER_SIEM_SEND_TIMEOUT=5
#   Per-event send timeout (seconds) to the syslog collector.

# --- splunk-hec ---
# TEE_CRAFTER_SIEM_ENDPOINT=https://hec.example.com:8088/services/collector
# TEE_CRAFTER_SIEM_TOKEN=
# TEE_CRAFTER_SIEM_INDEX=main
# TEE_CRAFTER_SIEM_SOURCETYPE=tee_crafter:attestation
# TEE_CRAFTER_SIEM_SOURCE=tee-crafter

# --- datadog ---
# TEE_CRAFTER_SIEM_API_KEY=
# TEE_CRAFTER_SIEM_SITE=datadoghq.com
# TEE_CRAFTER_SIEM_SERVICE=tee-crafter
# TEE_CRAFTER_SIEM_DDSOURCE=tee-crafter
# TEE_CRAFTER_SIEM_ENV=prod

# --- Collector addressing ---
# TEE_CRAFTER_SIEM_BEARER=              bearer token for a generic HTTPS collector
# TEE_CRAFTER_SIEM_COLLECTOR_HOST=      nitro-aws: collector reachable from the parent
# TEE_CRAFTER_SIEM_COLLECTOR_PORT=      nitro-aws: matching port
#
# The five below belong to `azure-monitor` and `cloudwatch`, which the in-TEE
# exporter builder still reads but `--siem` does NOT offer: exporter classes
# exist under core/audit/exporters/ and are wired into
# templates/common/tee_crafter_runtime_bootstrap.py, while the *sidecar* factory
# has no branch for them, so selecting one produced a crash-looping sidecar
# behind a deploy that reported success.  They are listed for completeness, not
# as something to set.  See SIEM_PROVIDERS in cli/commands/deploy/siem_mode.py.
# TEE_CRAFTER_SIEM_DCE_URL=             azure-monitor data collection endpoint
# TEE_CRAFTER_SIEM_DCR_IMMUTABLE_ID=    azure-monitor data collection rule id
# TEE_CRAFTER_SIEM_STREAM_NAME=         azure-monitor stream name
# TEE_CRAFTER_SIEM_LOG_GROUP=           cloudwatch Logs group
# TEE_CRAFTER_SIEM_LOG_STREAM=          cloudwatch Logs stream
# TEE_CRAFTER_SIEM_REGION=              region for the AWS-hosted collector
#   Falls back to us-east-2 when unset.  That is a plain default, not a
#   statement about where your collector is; set it explicitly.

# --- HTTPS transport hardening (splunk-hec / datadog) ---
# TEE_CRAFTER_SIEM_X_VERIFY_SSL=1
#   1 = verify the collector's TLS cert (production default).  0 = skip
#   verification — only honoured if ALLOW_INSECURE is also set.
# TEE_CRAFTER_SIEM_X_ALLOW_INSECURE=0   (production default; dev hatch)
#   1 = permit VERIFY_SSL=0 (skip TLS verification).  Off => the sidecar
#   refuses to start with verification disabled (fail-closed on transport).

# --- SIEM sidecar process (resources/systemd/tee-crafter-siem.service) ---
# TEE_CRAFTER_SIEM_ENV_FILE=
#   Path the sidecar reads its SIEM_* config from (set by deploy; the
#   systemd unit points here).  Empty = read straight from the environment.
# TEE_CRAFTER_PIPELINE_VERSION=
#   Pipeline tag stamped on exported events.  Empty = derived as
#   "tee-crafter-sidecar-<platform>".

# Extension knobs from siem.json "extra" map → TEE_CRAFTER_SIEM_X_<KEY>


###############################################################################
# 22. BYOK — in-TEE env (byok_mode.ByokConfig.to_env + runtime bootstrap)
#
# Host: TEE_CRAFTER_BYOK + TEE_CRAFTER_BYOK_CONFIG (JSON path), both in §6.
# In-TEE names:
###############################################################################

# TEE_CRAFTER_BYOK_ENABLED=0
# TEE_CRAFTER_BYOK=none
# TEE_CRAFTER_BYOK_KEY_ID=
# TEE_CRAFTER_BYOK_REGION=
# TEE_CRAFTER_BYOK_LABEL=
# TEE_CRAFTER_BYOK_UNWRAP=direct_bytes
#   direct_bytes | aws_nitro_recipient | rsa_oaep_sha256
# TEE_CRAFTER_BYOK_DEK_PATH=/run/tee_crafter/byok_dek.bin
#   tmpfs-backed (0600) path where the released DEK lands; also where the
#   in-TEE fail-closed gate looks for it.
# TEE_CRAFTER_BYOK_MAX_AGE=300
#   Max accepted attestation age (seconds) at key-release time.
# TEE_CRAFTER_BYOK_REQUIRE_SIGNED_AUDIT=1
#   1 = require a signed audit record before release (production).  0 = off.
# TEE_CRAFTER_BYOK_ENCRYPTION_CONTEXT=tenant=acme,env=prod
#   AAD / KMS encryption-context pins bound into the release request.
# TEE_CRAFTER_BYOK_REQUIRED_CONTEXT_KEYS=tenant,env
#   Context keys that MUST be present, else release is refused.
# TEE_CRAFTER_BYOK_ALLOW_ANY_MEASUREMENT=0   (SECURITY GATE; production default)
#   Off by default, and an empty allowed-measurement list is then a hard
#   validation error rather than a silent pass -- an empty allowlist would
#   otherwise disable the measurement gate entirely and release the DEK to any
#   image.  1 = release without checking the launch measurement at all.  Only a
#   recognised truthy spelling opens it.
# TEE_CRAFTER_BYOK_AZURE_WRAPPED_DEK=
#   Pre-wrapped DEK for the azure-skr path, when it was produced out of band
#   instead of by byok-stage.  Normally set by deploy.
# TEE_CRAFTER_BYOK_ALLOWED_MEASUREMENTS=aa…64hex,bb…64hex
#   SHA-256 measurement allowlist.  Deploy auto-fills this from the bake-time
#   pinned launch measurement; set manually only to add extra baselines.
# TEE_CRAFTER_BYOK_HSM_ENDPOINT=https://hsm.example.com/v1/release
# TEE_CRAFTER_BYOK_HSM_BEARER=
# TEE_CRAFTER_BYOK_GRACE_SECONDS=30
#   Startup grace (seconds) after process boot before the in-TEE BYOK
#   fail-closed gate can trip (lets the secrets oneshot drop the DEK first).

# Extension knobs from byok.json "extra" → TEE_CRAFTER_BYOK_X_<KEY>
# Internal (auto-set by deploy/byok-stage — do NOT set by hand):
#   TEE_CRAFTER_BYOK_X_CIPHERTEXT_B64           wrapped-DEK ciphertext
#   TEE_CRAFTER_BYOK_X_SECRET_ENV_BUNDLE_B64    envelope-sealed .env bundle

# CI gate (host-side, deploy):
# TEE_CRAFTER_REQUIRE_BYOK_MEASUREMENT=0
#   1 = deploy hard-fails when BYOK is requested but no measurement baseline
#   can be resolved (CI guard).  Default 0 = warn-only (the deploy-time
#   ALLOW_UNPINNED gate below is the runtime fail-closed control).

# --- Runtime fail-closed dev hatches (production default = fail closed) ------
# All three default OFF (fail-closed). Set =1 ONLY for local prototyping.
# TEE_CRAFTER_BYOK_FAIL_OPEN=0       (serve even if the attested DEK is absent)
# TEE_CRAFTER_SECRETS_FAIL_OPEN=0    (start the workload even if sealed/baked
#                                     .env or BYOK release fails in the oneshot)
# TEE_CRAFTER_ALLOW_UNPINNED_MEASUREMENT=0
#   Permit sealed --secrets-env / BYOK on a CVM image that has no bake-time
#   pinned launch measurement. Off => deploy refuses (no vetted baseline).

# TEE_CRAFTER_REQUIRE_PINNED_MEASUREMENT=0   (CI guard; warn-only by default)
#   Governs audit check ATT-003.  A client that found no baked baseline pins
#   whatever it first sees (trust-on-first-use), which proves the runtime
#   measurement is self-consistent but not that it matched anything vetted.
#   0 = record ATT-003 as WARN.  1 = record it as FAIL, so a self-pinned run
#   cannot be reported as a clean deploy.  Set this in CI.


###############################################################################
# 23. In-TEE runtime protections — request sandbox, key rotation, audit chain
#     (templates/common/tee_crafter_handler_sandbox.py,
#      tee_crafter_key_rotation.py, siem_export.py, audit_logger.py)
###############################################################################

# --- Request-path sandbox ---
# Under the container model you do not write a request handler -- you ship a
# Dockerfile.  What this sandboxes is the generated `process_request` shim in
# the platform app template: the in-TEE code that forwards each request from
# the RA-TLS terminator to your container on 127.0.0.1.  That shim runs in the
# same interpreter as the attestation / ECDH key material, so it gets a
# per-request rlimit + seccomp jail.  Persistent mode only; staged into every
# platform app bundle and engaged at runtime.
#
# TEE_CRAFTER_HANDLER_SANDBOX=1   (production default; dev hatch)
#   1 = wrap each request in the rlimit/seccomp sandbox (production).
#   0 = disable the sandbox entirely (DEBUG ONLY — never in production).
# TEE_CRAFTER_HANDLER_SANDBOX_FORCE_SECCOMP=0   (production default; dev hatch)
#   1 = hard-require seccomp; refuse to serve if the kernel cannot install
#   the syscall filter.  Default 0 = best-effort (fall open with a warning
#   on hosts without seccomp, e.g. some Gramine-SGX / unprivileged hosts).
# TEE_CRAFTER_HANDLER_SANDBOX_RLIMIT_CPU_SEC=30
#   Per-request wall-CPU seconds (RLIMIT_CPU).  Raise for heavy handlers.
# TEE_CRAFTER_HANDLER_SANDBOX_RLIMIT_AS_MB=0
#   Per-request virtual-memory cap in MiB (RLIMIT_AS).  0 = unlimited.
# TEE_CRAFTER_HANDLER_SANDBOX_RLIMIT_FSIZE_MB=0
#   Per-request max file-write size in MiB (RLIMIT_FSIZE).  0 = unlimited.

# --- ECDH session key rotation ---
# TEE_KEY_ROTATION_SECS=3600
#   How often the in-TEE ECDH session key is rotated.  Each rotation is
#   attestation-bound and recorded in the hash-chained runtime audit log.
# TEE_KEY_GRACE_SECS=
#   Overlap window during which the previous key is still accepted, so
#   in-flight requests are not dropped at the rotation boundary.
# TEE_KEY_MAX_REQUESTS=
#   Rotate early once a key has served this many requests, whichever
#   threshold is reached first.

# --- Audit-log chain commitment ---
# TEE_CRAFTER_CHAIN_COMMITMENT_PATH=
#   Path the in-TEE audit logger writes its HMAC chain-key commitment to, and
#   the SIEM exporter reads it from.  Every exported event carries this value
#   so `verify-siem-chain --expect-chain-commitment <sha256>` can bind the
#   stream to the commitment the enclave published in its attestation
#   report_data.  Defaults are set by the staged templates; override only for
#   a non-standard layout.


###############################################################################
# 24. In-VM batch runner
#
# NOTE: the module these were written for (templates/common/batch_runner.py) is
# not present in this tree, and BATCH_SEALED_INPUT is read nowhere in apps/.
# The BATCH_* names below are therefore inert today — they are kept as the
# intended interface, not as knobs that currently do anything. See the
# seal-input warning in docs/cli_reference.md.
###############################################################################

# BATCH_RUNTIME_DIR=/workspace/runtime
# BATCH_SCRATCH_DIR=/workspace/scratch_tmp
# BATCH_OUTPUT_DIR=/var/lib/tee_crafter/output
# BATCH_INPUT_DIR=/workspace/runtime/input
# BATCH_SEALED_INPUT=
# BATCH_SEALED_PRIVATE_KEY=
# BATCH_SEALED_EXPECTED_SPKI=
# BATCH_SEALED_EXPECTED_BUILD=
# BATCH_CMD=
# BATCH_USER_TIMEOUT_SEC=


###############################################################################
# 25. In-VM attestation monitor + audit logger (staged templates)
###############################################################################

# TEE_CRAFTER_TEE_PLATFORM=
#   In-TEE platform identity (snp-aws | snp-azure | snp-gcp | tdx-azure |
#   tdx-gcp | gpu-cc-aws | gpu-cc-azure | gpu-cc-gcp | nitro-aws | sgx-azure).
#   Auto-set by deploy into the systemd unit environment and consumed by the
#   SIEM exporter / fail-closed gate / secrets oneshot.  Leave unset on the
#   host; documented here for completeness.

# TEE_AUDIT_LOG_DIR=/var/log/tee_crafter
# TEE_ATTESTATION_INTERVAL_SECS=300
# TEE_ATTESTATION_DRIFT_KILL=3   (production default; dev hatch =0 = log-only)
#   N>=1 = self-shutdown after N consecutive drift/failure samples
#   (orchestrator then tears the VM down).  0 = log only (regression
#   tests / inspection-only deploys).

# TEE_AUDIT_MAX_SIZE_MB=50


###############################################################################
#                                                                             #
#   TERRAFORM LAYER                                                           #
#                                                                             #
###############################################################################


###############################################################################
# 26. Terraform TF_VAR_* — union of variables in templates/**/main.template.tf
#
# Only variables that appear in at least one platform template are listed.
# Uncomment and set for your target; irrelevant vars are ignored by modules
# you do not apply.  Where a name appears under more than one cloud it is the
# same input consumed by that cloud's template.
#
# ---- Shared / naming ----
# TF_VAR_admin_username=azureuser
#
# ---- AWS (nitro / snp-aws / gpu-cc-aws) ----
# TF_VAR_aws_region=us-east-2
# TF_VAR_instance_type=m6a.xlarge
# TF_VAR_subnet_id=
# TF_VAR_use_spot_instance=false
# TF_VAR_allow_setup_egress=false
# TF_VAR_custom_ami_id=
# TF_VAR_vpc_cidr=10.0.0.0/16
# TF_VAR_skip_vpc_endpoints=false
# TF_VAR_create_s3_gateway_endpoint=true
# TF_VAR_existing_instance_profile_name=
# TF_VAR_existing_enclave_role_arn=
# TF_VAR_existing_security_group_id=
# TF_VAR_existing_deployment_bucket=
# UEFI Secure Boot on nitro-aws / snp-aws is an AMI property baked into
# Image.UefiData by `tee-crafter internal bake-ami` (Secure Boot is enrolled
# by default).  The Terraform variable also defaults to `true`, and the deploy
# CLI auto-detects the `tee-crafter-secure-boot=enabled` AMI tag, so most
# operators NEVER need to set this manually.  Override here (true/false) only
# for the legacy unbaked dev path (`TEE_CRAFTER_ALLOW_UNBAKED_BASE_AMI=1`
# + a stock Canonical/AL2023 AMI requires `TF_VAR_enable_secure_boot=false`).
# Has NO effect on gpu-cc-aws (intentionally off — unsigned NVIDIA DKMS).
# See docs/security.md §15.1A for the full design.
# TF_VAR_enable_secure_boot=true
#
# ---- Nitro-only ----
# TF_VAR_allocator_mb=
# TF_VAR_cpu_count=
# TF_VAR_create_kms_vpc_endpoint=true
# TF_VAR_ami_architecture=x86_64
# TF_VAR_pcr0_hash=
# TF_VAR_pcr1_hash=
# TF_VAR_pcr2_hash=
#
# ---- SNP-AWS / GPU-CC-AWS measurement ----
# TF_VAR_measurement=

# ---- GPU-CC-AWS-only ----
# TF_VAR_gpu_availability_zone=
# TF_VAR_allow_nras_egress=true
# TF_VAR_nras_egress_cidrs=[]
# TF_VAR_require_nitro_tpm=true

# ---- AWS SIEM egress (siem_egress_terraform.py may set these) ----
# TF_VAR_siem_provision_logs_endpoint=false
# TF_VAR_siem_egress_cidrs=[]
# TF_VAR_siem_egress_ports=[443]

# ---- Azure (sgx / tdx / snp / gpu-cc azure templates) ----
# TF_VAR_azure_location=westus
# TF_VAR_vm_size=Standard_DC2s_v3
# TF_VAR_custom_image_id=
# TF_VAR_use_spot_instance=false
# TF_VAR_allow_setup_egress=false
# TF_VAR_siem_egress_cidrs=[]
# TF_VAR_siem_egress_ports=[443]

# ---- SGX-only ----
# TF_VAR_mrenclave=
# TF_VAR_mrsigner=

# ---- TDX-Azure-only ----
# TF_VAR_mrtd=

# ---- SNP-Azure-only ----
# TF_VAR_measurement=

# ---- GPU-CC-Azure-only ----
# TF_VAR_allow_nras_egress=true
# TF_VAR_nras_egress_cidrs=[]
# TF_VAR_allow_nras_broad_internet=false
# TF_VAR_enable_secure_boot=false
#   Defaults to FALSE on both GPU platforms, unlike nitro-aws and snp-aws where
#   it defaults to true.  The NVIDIA DKMS modules are unsigned, so an image with
#   Secure Boot enrolled will not load the GPU driver.  Setting this true
#   produces a VM that boots without a working GPU.
# TF_VAR_measurement=

# ---- GCP (snp / tdx / gpu-cc gcp templates) ----
# TF_VAR_gcp_project=
# TF_VAR_gcp_region=us-central1
# TF_VAR_gcp_zone=us-central1-a
# TF_VAR_machine_type=n2d-standard-2
# TF_VAR_custom_image=
# TF_VAR_allow_setup_egress=false
# TF_VAR_use_spot_instance=false
# TF_VAR_siem_egress_cidrs=[]
# TF_VAR_siem_egress_ports=[443]
# TF_VAR_measurement=

# ---- TDX-GCP-only ----
# TF_VAR_min_cpu_platform=Intel Sapphire Rapids
# TF_VAR_mrtd=

# ---- GPU-CC-GCP-only ----
# TF_VAR_allow_nras_egress=true
# TF_VAR_nras_egress_cidrs=[]
# TF_VAR_allow_nras_broad_internet=false
# TF_VAR_enable_secure_boot=false      # false for the same DKMS reason as Azure


###############################################################################
# 27. Standard Terraform diagnostics (optional — not TEE-Crafter-specific)
#
# Read by the `terraform` binary itself, not by TEE-Crafter.
###############################################################################

# TF_LOG=INFO
# TF_LOG_PATH=/tmp/terraform.log
