# --- 1. LLM Configuration ---
# Choose your provider with: --llm-provider local|openai|anthropic|gemini

# Local (default): llama-server running on your machine
LLAMA_SERVER_BASE_URL=http://127.0.0.1:8080/v1

# OpenAI: Set your API key and optionally override the model (default: gpt-4o)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Anthropic: Set your API key and optionally override the model (default: claude-sonnet-4-20250514)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini: Set your API key and optionally override the model (default: gemini-2.5-flash)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- 2. AWS Authentication (Required) ---

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- 3. Deployment Configuration (Optional) ---
# Region: Defaults to us-east-2 if omitted.
TF_VAR_aws_region=
AWS_REGION=${TF_VAR_aws_region:-us-east-2}

# Subnet: Defaults to the Default VPC's first public subnet if omitted.
TF_VAR_subnet_id=

# --- 4. Advanced / Debugging ---
NITRO_AGENT_IAC_DEBUG=false
NITRO_AGENT_PHASE4_MAX_RETRIES=3
NITRO_AGENT_TF_AUTO_APPROVE=false
