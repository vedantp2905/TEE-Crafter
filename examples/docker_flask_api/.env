# Example app config + secrets, delivered into the TEE via:
#   tee-crafter deploy ... --secrets-env ./examples/docker_flask_api/.env
#
# With --byok aws-kms/gcp-kms this file is envelope-sealed and released only
# inside the attested enclave (tmpfs-only). Without BYOK it is baked into the
# measured image (fine for non-secret config; use --byok for real secrets).
PORT=8080
ENVIRONMENT=production
API_TOKEN=demo-rotate-me-in-real-deployments
# Non-secret marker echoed by GET /health so you can confirm .env injection
# worked end-to-end (it is "<.env NOT injected>" if the file never arrived).
APP_BANNER=tee-crafter .env injection OK
