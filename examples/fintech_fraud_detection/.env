# Real secrets for the fraud engine, delivered into the TEE via:
#   tee-crafter deploy ... --secrets-env ./examples/fintech_fraud_detection/.env
#
# These are SECRETS — deploy with --byok aws-kms/gcp-kms so the file is
# envelope-sealed and released only inside the attested enclave (tmpfs-only).
# If the DB / API is reachable over the public internet, pair with
# --egress-mode nat --egress-allow db.internal:5432 to open a default-deny
# allowlisted egress path.
ENVIRONMENT=production
DATABASE_URL=postgres://fraud_ro:CHANGE_ME@db.internal:5432/transactions
RISK_API_TOKEN=sk-live-CHANGE_ME
# Block a transaction when its additive risk score (0–150) is >= this value.
# It is echoed in the job output so you can confirm .env injection worked.
SCORE_THRESHOLD=80
