# App config + secrets for the confidential GPU inference service, delivered
# into the TEE via:
#   tee-crafter deploy ... --secrets-env ./examples/gpu_confidential_inference/.env
#
# NVIDIA_NRAS_API_KEY must be NON-EMPTY: it satisfies the CLI's GPU-CC gate.
# The NRAS endpoint itself does not consume it as a Bearer token — see
# docs/gpu_flow.md#nvidia-remote-attestation-service-nras.
#
# Seal these with --byok gcp-kms/azure-kv so the file is envelope-sealed and
# released only inside the attested enclave (tmpfs-only). Without BYOK the file
# is baked into the measured image (fine for non-secret config).
NVIDIA_NRAS_API_KEY=set-me-any-nonempty-value
PORT=8080
ENVIRONMENT=production
MODEL_VERSION=radiology-efn-b0-v1
