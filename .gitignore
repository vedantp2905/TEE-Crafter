venv/
builds/
# setuptools staging dir. Note this is `build/`, NOT the `builds/` above --
# both exist under apps/cli/ and the plural rule does not cover the singular.
# It held a 294-file stale copy of src/tee_crafter, including a verifier client
# whose SEV-SNP AK-binding gate still had the pre-fix `== "1"` comparison, so the
# repo shipped two copies of one security check with one of them broken.
# Regenerated by any `pip install .`; never an input.
/apps/cli/build/
__pycache__/
*.egg-info/
.pytest_cache/
.terraform/
# Provider download cache used by .github/scripts/generate_provider_locks.py.
# Multiple GB of provider binaries; the lockfiles it produces ARE committed.
# (State and plan output are already ignored further down.)
.terraform-plugin-cache/
.env
# Hand-made backups and variants of the real .env. `.env` alone does not match
# `.env.bak`, `.env.local` or `.env.save`, so a routine `cp .env .env.bak`
# before editing credentials produces an untracked file full of live secrets
# that `git add -A` would happily commit.
.env.*
!.env.example
# Example .env files are committed on purpose (demo config, no real secrets).
!examples/**/.env
.cursorignore
.cursor
.claude/
docs/report.tex
# Internal audit tracker and the 21 raw workstream reports behind it (~19,800
# lines). Working notes, not documentation: they contain findings later
# disproved, severities later revised, and pre-fix snapshots of code that has
# since changed. Deliberately NOT published — the honest summary of what is and
# is not verified lives in README.md instead, where a reader will actually see
# it. Kept locally for tracking. (The audit flagged this itself: both were
# untracked *and* unignored, so a `git add -A` would have published them.)
/AUDIT_FINDINGS.md
/docs/audit-evidence/
*.DS_Store
.sgx-dev-installed
*.zip

# Private key material — never commit.  The vendor root/intermediate CA
# certificates under certs/ are PUBLIC trust anchors and MUST be committed:
# without them every attestation verifier loads an empty trust store.
*.pem
!apps/cli/src/tee_crafter/certs/*.pem

# Test artifacts
apps/cli/tests/integration/.cache/
apps/cli/tests/integration/generated/
apps/cli/tests/integration/*_results.json
.tee-crafter-cache/
.gcloud/
gcp-key*.json

# ---------------------------------------------------------------------------
# Scanner output only.
#
# This was previously a bare ``*.json``, which silently excluded
# ``templates/common/seccomp-container.json`` (breaking bake-ami on 9 of 10
# platforms), the entire ``measurements/`` baseline registry (making the
# measurement-pinning feature unable to ship), and every example's data and
# schema files.  Scope it to the scanner artefacts it was written for.
# ---------------------------------------------------------------------------
trivy-*.json
grype-*.json
/scan-results/

# Generated SIEM configs embed live HEC tokens / API keys.  Sample configs
# are committed on purpose.
apps/cli/siem-sandbox/configs/siem-via-*.json

# BYOK sandbox: never commit live key configs (they carry real
# ciphertext+KMS ARNs that point at a customer's KMS) or plaintext DEKs.
apps/cli/byok-sandbox/configs/*.json
apps/cli/byok-sandbox/configs/*.dek.b64
!apps/cli/byok-sandbox/configs/*-sample.json

# Anywhere these names appear they hold bearer tokens or wrapped key
# material that must NEVER land in git.  Catches accidental "I just
# dropped a working config into the repo to share with my team" cases.
**/siem.env
**/siem.env.public
**/byok.env
**/byok.env.public
**/byok.json
*.dek.b64
*.dek.bin

# Terraform provider lockfiles ARE committed (reproducible infra builds).
# Only local state, variables and plan output are ignored. State carries
# resource attributes; tfvars routinely carry credentials.
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan

# JS / Next.js: installs and build cache — never commit
node_modules/
.next/

# Local docker-compose port remaps for the SIEM sandbox. Host ports 8000/8080
# collide with anything else already running on a dev laptop, so the override
# is per-machine and must not be committed.
apps/cli/siem-sandbox/*/docker-compose.override.yml

# Vulnerability-scan output written next to a --source tree at deploy time.
*/.tee_crafter_scan/
**/.tee_crafter_scan/

# Operator-generated SIEM/BYOK configs. These carry live material — HEC tokens,
# KMS key ARNs, wrapped DEK ciphertext, collector addresses — and are specific
# to one machine or session. `siem-sandbox/configs/splunk-local.json` is the
# only committed example; anything generated by the make_remote_* scripts or by
# byok-sandbox/*/create_kms_key.py stays local.
/configs/
# Same output, one directory over: create_kms_key.py resolves its default
# --out relative to the CWD, so running it from the repo root writes a live
# key config to /byok-sandbox/configs/ instead of apps/cli/byok-sandbox/
# configs/ — outside the rule below and therefore committable. Happened
# 2026-08-23.
/byok-sandbox/
apps/cli/siem-sandbox/configs/*-via-ngrok.json
apps/cli/siem-sandbox/configs/byok-*.json

# Live Datadog API key for the C7 hardware run — never commit.
apps/cli/siem-sandbox/configs/datadog-us3.json

# `--byok azure-skr` writes its key descriptor next to wherever it was run, so
# running from the repo root drops one at the top level, outside every rule
# above. It names a live Key Vault, key and key version from a real
# subscription. Not a secret, but it is one deployment's infrastructure and it
# has no business in a published repo. Found 2026-08-23 while staging a clean
# checkout: `byok-snp-azure-skr.json` was untracked and unignored, so any
# `git add -A` would have committed it.
/byok-*-skr.json
