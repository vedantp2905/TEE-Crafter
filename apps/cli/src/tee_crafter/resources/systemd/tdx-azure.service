[Unit]
Description=TEE-Crafter TDX Application Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tee_enclave
Group=tee_enclave
# kvm  — /dev/tdx-guest and the configfs-tsm report dir (DCAP path).
# tss  — /dev/tpmrm0. On an Azure paravisor CVM the vTPM is the ONLY source of
#        attestation evidence, so this is load-bearing there, not a fallback:
#        AttestationClient reads the HCL report out of it to build the
#        /attest/AzureGuest request. Membership, not a capability.
SupplementaryGroups=kvm tss
WorkingDirectory=/opt/tee-crafter-tdx/app
# The last clause is the TCG event log, and it is load-bearing on this
# platform.  `AttestationClient` builds the /attest/AzureGuest request out of
# three things -- the vTPM quote, the HCL hardware report and the TCG log --
# and the kernel exports that log as `-r--r----- root root`, so an
# unprivileged reader gets nothing.  The client does not fail when it cannot
# read it; it sends the request without it, and MAA rejects that with
#
#   InvalidParameter / MissingKey: "TcgLogs is empty in attestation request."
#
# which reads like a platform or API-version problem and is not one.  Measured
# on tee-crafter-tdx-vm-a5d16b8b, 2026-08-23: run as root the same binary
# returns a valid JWT, run as `tee_enclave` it returns exactly that error, and
# a single `chgrp tee_enclave` on the log turns the second into the first.
#
# Granting the group is deliberately preferred over
# AmbientCapabilities=CAP_DAC_READ_SEARCH, which would also work: the
# capability would let the workload read *every* file on the system, while
# this grants read on one append-only kernel log.  See the capabilities note
# below -- this unit already dropped CAP_DAC_OVERRIDE for the same reason.
ExecStartPre=+/bin/bash -c 'chgrp kvm /sys/kernel/config/tsm/report/ 2>/dev/null; chmod 0775 /sys/kernel/config/tsm/report/ 2>/dev/null; mkdir -p /sys/kernel/config/tsm/report/tee-crafter-0 2>/dev/null; chgrp kvm /sys/kernel/config/tsm/report/tee-crafter-0/inblob /sys/kernel/config/tsm/report/tee-crafter-0/outblob 2>/dev/null; chmod 0660 /sys/kernel/config/tsm/report/tee-crafter-0/inblob 2>/dev/null; for d in /dev/tdx-guest /dev/tdx_guest; do [ -c "$d" ] && chmod 0660 "$d" && chgrp kvm "$d"; done; for d in /dev/tpmrm0 /dev/tpm0; do [ -c "$d" ] && chmod 0660 "$d" && chgrp tss "$d" 2>/dev/null; done; L=/sys/kernel/security/tpm0/binary_bios_measurements; [ -e "$L" ] && chgrp tee_enclave "$L" 2>/dev/null; true'
ExecStart=/opt/tee-crafter-tdx/venv/bin/python3 app_tdx.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
# Continuous-attestation SIEM exporter reads its config from this file.
# SIEM-SEC-2: token-bearing env on tmpfs (never persisted).
EnvironmentFile=-/run/tee-crafter-tdx-azure/siem.env
EnvironmentFile=-/opt/tee-crafter-tdx/app/siem.env.public
# BYOK-SEC-1: see tdx-gcp.service for rationale.
EnvironmentFile=-/run/tee-crafter-tdx-azure/byok.env
EnvironmentFile=-/opt/tee-crafter-tdx/app/byok.env.public

LogsDirectory=tee_crafter
ReadWritePaths=/tmp /var/log/tee_crafter /opt/tee-crafter-tdx -/dev/tdx-guest -/dev/tdx_guest -/sys/kernel/config/tsm -/dev/tpm0 -/dev/tpmrm0
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# ProtectKernelTunables stays OFF, deliberately: it mounts /sys read-only, and
# the configfs-tsm attestation path has to CREATE a report directory under
# /sys/kernel/config/tsm/report to fetch a quote (see
# core/keys/attestation_providers.py::_read_tdx_report and
# core/measurements/capture.py).  Turning it on breaks attestation.
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
DeviceAllow=/dev/tdx-guest rw
DeviceAllow=/dev/tdx_guest rw
DeviceAllow=/dev/tpm0 rw
DeviceAllow=/dev/tpmrm0 rw
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @resources
LimitNOFILE=65536
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
# Capabilities: none.  The service runs as the unprivileged `tee_enclave`
# user and needs no capability at all -- the `+`-prefixed ExecStartPre above
# runs with full privileges (systemd.service(5): with `+`, "privilege
# restrictions configured with User=, Group=, CapabilityBoundingSet= or the
# various file system namespacing options ... are not applied") and hands the
# attestation device and the configfs-tsm report directory to the `kvm` group,
# which this unit joins via SupplementaryGroups=.  Group membership, not a DAC
# bypass, is what makes /dev/sev-guest, /dev/tdx-guest and
# /sys/kernel/config/tsm/report reachable.
#
# This unit previously carried AmbientCapabilities=CAP_DAC_OVERRIDE, which let
# the workload bypass every file permission check on the system -- far more
# than the attestation path needs.  gpu-cc-aws.service and
# gpu-cc-azure.service already run the same SEV-SNP / TDX device paths with an
# empty CapabilityBoundingSet and no ambient capabilities, which is the
# evidence that the capability was not load-bearing.
CapabilityBoundingSet=
SystemCallFilter=~@privileged @obsolete @raw-io @reboot @swap @debug @cpu-emulation @module @mount @keyring @pkey
PrivateUsers=no
RemoveIPC=yes
KeyringMode=private
ProtectProc=invisible
# The cloud SDKs used by the BYOK release path and the SIEM exporter fetch
# their credentials from the instance metadata service at 169.254.169.254
# (boto3 IMDSv2, google-auth ADC via metadata.google.internal, azure-identity
# ManagedIdentityCredential).  That address is inside `link-local`, so the deny
# below would black-hole every credential fetch; the longer /32 prefix wins, so
# this allow re-opens exactly the metadata service and nothing else.  Matches
# nitro-aws.service, which has always allowed it explicitly.
IPAddressAllow=169.254.169.254/32
IPAddressDeny=link-local multicast
# SBX-2: defence-in-depth process-wide ceilings.
MemoryMax=16G
TasksMax=4096
TimeoutStartSec=90s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
