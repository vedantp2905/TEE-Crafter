[Unit]
Description=Host API Proxy for Nitro Enclave
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=tee_enclave
Group=tee_enclave
WorkingDirectory=/opt/tee-crafter
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
ExecStartPre=/bin/test -f /opt/tee-crafter/host_proxy.py
ExecStart=$PYTHON_BIN -m uvicorn host_proxy:app --host 127.0.0.1 --port 443 --ssl-keyfile=/etc/tee_crafter/certs/host.key --ssl-certfile=/etc/tee_crafter/certs/host.crt
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Must exist before ProtectSystem+ReadWritePaths mount namespacing runs; systemd
# creates /var/log/tee_crafter with correct ownership when this is set.
LogsDirectory=tee_crafter
ReadWritePaths=/tmp /var/log/tee_crafter /opt/tee-crafter /etc/tee_crafter
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @resources
SystemCallFilter=~@privileged
LimitNOFILE=65536
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_VSOCK
UMask=0077
SystemCallFilter=~@obsolete @raw-io @reboot @swap @debug @cpu-emulation @module @mount @keyring @pkey
PrivateUsers=no
RemoveIPC=yes
KeyringMode=private
ProtectProc=invisible
# Loopback: the FastAPI/uvicorn listener.  169.254.169.254/32: IMDSv2,
# the only outbound destination the host-proxy ever talks to (it resolves
# short-lived instance-role credentials per request; the enclave itself
# talks to KMS over vsock-proxy, not the host_proxy's network namespace).
IPAddressAllow=127.0.0.0/8 169.254.169.254/32
IPAddressDeny=any
# SBX-2: host-side proxy is small; user code runs inside the enclave.
MemoryMax=2G
TasksMax=1024
TimeoutStartSec=60s
TimeoutStopSec=20s

[Install]
WantedBy=multi-user.target
