[Unit]
Description=TEE-Crafter Secret Bootstrap ({tee_platform})
# Runs after the network/device are up; the user container unit Requires= and
# After= this oneshot, so a fail-closed exit here keeps the workload stopped.
After=network.target

[Service]
# oneshot + RemainAfterExit: the container unit's Requires= treats a non-zero
# exit as "dependency failed" and refuses to start the workload (fail-closed).
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={remote_base}/app
Environment=PYTHONUNBUFFERED=1
Environment=TEE_CRAFTER_TEE_PLATFORM={tee_platform}
# Secret-bearing env on tmpfs (wrapped DEK + sealed-.env bundle), public halves
# on disk — exact mirror of the app unit's EnvironmentFile set.
EnvironmentFile=-/run/{tmpfs_dir}/byok.env
EnvironmentFile=-{remote_base}/app/byok.env.public
EnvironmentFile=-/run/{tmpfs_dir}/siem.env
EnvironmentFile=-{remote_base}/app/siem.env.public
# Relax device perms so the report read works, then drop into the bootstrap.
ExecStartPre=+/bin/bash -c 'mkdir -p /run/tee_crafter; chmod 0700 /run/tee_crafter; chgrp kvm /sys/kernel/config/tsm/report/ 2>/dev/null || true; chmod 0775 /sys/kernel/config/tsm/report/ 2>/dev/null || true; for d in /dev/sev-guest /dev/sev /dev/tdx-guest; do [ -c "$d" ] && chmod 0660 "$d"; done; true'
ExecStart={remote_base}/venv/bin/python3 {remote_base}/app/tee_crafter_secret_bootstrap.py {tee_platform}
TimeoutStartSec=120s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
