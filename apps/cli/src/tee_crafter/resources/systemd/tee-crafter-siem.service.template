[Unit]
Description=TEE-Crafter SIEM continuous-attestation exporter sidecar
After=tee-crafter-snp.service tee-crafter-tdx.service tee-crafter-gpu-cc.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tee_enclave
Group=tee_enclave
SupplementaryGroups=kvm
WorkingDirectory={remote_app_dir}
# SIEM-SEC-2: token-bearing env lives on tmpfs (/run is tmpfs on all
# modern systemd distros) so it never makes it into a disk snapshot.
# The deploy-time installer relocates {remote_app_dir}/siem.env into
# /run/tee-crafter-{tee_platform}/siem.env and shreds the disk copy.
# Leading ``-`` keeps the unit bootable after a reboot wipes /run
# (operator re-stages with ``tee-crafter siem-stage``).
EnvironmentFile=-/run/tee-crafter-{tee_platform}/siem.env
# Public, non-secret SIEM config (provider name, endpoint, index, …) may
# still ride along on disk for ergonomic redeploys; the gates the
# sidecar enforces (verify_ssl, allow_insecure, fail_closed) are not
# secrets and we want them to survive reboots even when the token does
# not.
EnvironmentFile=-{remote_app_dir}/siem.env.public
Environment=PYTHONUNBUFFERED=1
Environment=TEE_CRAFTER_TEE_PLATFORM={tee_platform}
# Re-apply tsm/sev/tdx-guest permission fixups (idempotent) in case
# this sidecar starts before any other process has touched them.
ExecStartPre=+/bin/bash -c 'chgrp kvm /sys/kernel/config/tsm/report/ 2>/dev/null; chmod 0775 /sys/kernel/config/tsm/report/ 2>/dev/null; for d in /dev/sev-guest /dev/sev /dev/tdx-guest /dev/tdx_guest; do [ -c "$d" ] && chmod 0660 "$d" && chgrp kvm "$d"; done; true'
ExecStart={remote_venv}/bin/python3 {remote_app_dir}/siem_export.py
Restart=on-failure
RestartSec=5

AmbientCapabilities=CAP_DAC_OVERRIDE
DeviceAllow=/dev/sev-guest rw
DeviceAllow=/dev/sev rw
DeviceAllow=/dev/tdx-guest rw
DeviceAllow=/dev/tdx_guest rw
ReadWritePaths=/tmp -/dev/sev-guest -/dev/sev -/dev/tdx-guest -/dev/tdx_guest -/sys/kernel/config/tsm
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=no
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
# Sidecar only does HTTPS POST + /sys/kernel/config/tsm/ ioctls; no
# need to ever escalate to a setuid binary.  Stricter than the main
# app's relaxed `NoNewPrivileges=no` because the main app needs to
# drop into kvm group via systemd, which we don't.
NoNewPrivileges=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @resources
SystemCallFilter=~@privileged @obsolete @raw-io @reboot @swap @debug @cpu-emulation @module @mount @keyring @pkey
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=4096
MemoryHigh=128M
MemoryMax=256M
TasksMax=32
UMask=0077
CapabilityBoundingSet=CAP_DAC_OVERRIDE
PrivateUsers=no
RemoveIPC=yes
KeyringMode=private
ProtectProc=invisible
IPAddressDeny=link-local multicast
TimeoutStartSec=30s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
