# syslog-ng config for the TEE-Crafter SIEM sandbox.
# Copy to .env and edit only if you want to pin a different image tag.

# Pin in production for reproducibility.  syslog-ng publishes
# multi-arch images so Apple Silicon and amd64 hosts both work.
SYSLOG_NG_IMAGE_TAG=4.8.3

# --- Optional: ngrok TCP tunnel (cloud TEE -> laptop syslog-ng) ---
# Same free account as siem-sandbox/splunk/.  Required for
# `docker compose --profile ngrok up -d`.
NGROK_AUTHTOKEN=

# Paid ngrok: reserve a TCP endpoint in the dashboard, then set
# NGROK_TCP_URL=1.tcp.ngrok.io:27210 (passed to `ngrok tcp --url=...`).
NGROK_TCP_URL=
