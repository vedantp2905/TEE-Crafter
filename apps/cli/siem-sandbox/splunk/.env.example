# Splunk HEC config for local docker-compose.
# Copy to .env and edit if you want different credentials.

# Splunk admin password — used for the web UI on http://localhost:8000
# Must be at least 8 chars; Splunk refuses weak passwords.
SPLUNK_PASSWORD=changeme123!

# HEC token that TEE-Crafter uses to authenticate when POSTing events.
# Treat like a secret in prod; this static value is dev-only.
SPLUNK_HEC_TOKEN=11111111-1111-1111-1111-111111111111

# Splunk image tag.  Pin this in production for reproducibility.
SPLUNK_IMAGE_TAG=latest

# --- Optional: ngrok reverse tunnel (for real cloud TEE -> local Splunk) ---
# Sign up free at https://dashboard.ngrok.com → "Your Authtoken".
# Then `docker compose --profile ngrok up -d` will publish a public HTTPS URL
# that forwards to nginx-alb (and then on to Splunk).  Leave blank if you
# only want localhost smoke tests.
NGROK_AUTHTOKEN=

# Reserved subdomain bound to your ngrok account (free tier supports one).
# When set, the public URL is pinned so it survives container restarts
# and `tee-crafter deploy` always reaches the same place.  When empty,
# ngrok hands out a random *.ngrok-free.app URL each restart.
# Example: NGROK_RESERVED_DOMAIN=loyal-gertrud-unocular.ngrok-free.dev
NGROK_RESERVED_DOMAIN=
